generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Schedule {
  id        Int      @id @default(autoincrement())
  course    Int
  group     String
  groupFull String
  specialty String
  dayOfWeek String
  timeSlot  String
  subject   String
  teacher   String
  room      String?
  weekType  String   @default("both")
  campus    Campus   @default(MAIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([course, group])
  @@index([teacher])
  @@index([groupFull])
  @@index([weekType])
  @@index([campus])
  @@index([course, groupFull, dayOfWeek, timeSlot, weekType])
}

enum Campus {
  MAIN
  SECONDARY
}

model Teacher {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Replacement {
  campus          Campus?
  id              Int      @id @default(autoincrement())
  date            String
  course          Int
  groupFull       String
  pairNumber      Int
  originalSubject String?
  newSubject      String
  originalTeacher String?
  newTeacher      String
  room            String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, groupFull, pairNumber])
  @@index([date])
  @@index([campus, date])
  @@index([groupFull])
  @@index([course])
}

model WeekSettings {
  manualOverride  Boolean  @default(false)
  id              Int      @id @default(autoincrement())
  currentWeekType String   @default("numerator")
  startDate       String?
  updatedAt       DateTime @updatedAt
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  name         String
  passwordHash String
  campus       Campus?
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  username  String
  action    String
  entity    String
  entityId  String?
  campus    Campus?
  details   Json
  createdAt DateTime @default(now())
  @@index([createdAt, id])
  @@index([campus, createdAt])
}
